{
  "name": "solvaren",
  "version": "2.0.0",
  "private": true,
  "description": "SOLVAREN Payment Solutions \u2014 security-first business disbursement control plane. Move money with certainty.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "node scripts/migrate.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm check:invariants && pnpm test:coverage && pnpm db:test",
    "db:generate-seed": "node --experimental-strip-types scripts/generate-failure-seed.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "db:test": "bash scripts/db-test.sh",
    "test:integration": "SOLVAREN_TEST_DATABASE_URL=${SOLVAREN_TEST_DATABASE_URL:-postgres://postgres@localhost:5433/postgres} vitest run apps/api/src/integration.test.ts",
    "db:up": "bash scripts/dev-postgres.sh start",
    "db:down": "bash scripts/dev-postgres.sh stop",
    "ui:check": "pnpm --filter @solvaren/web build && node scripts/ui-check.mjs",
    "check:invariants": "bash scripts/check-invariants.sh"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.18.0",
    "playwright": "^1.63.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "hash-wasm": "^4.12.0",
    "postgres": "^3.4.9"
  }
}
