{
  "name": "@solvaren/web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false || tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "deploy:staging": "wrangler pages deploy dist --project-name solvaren-web-staging",
    "deploy:production": "wrangler pages deploy dist --project-name solvaren-web"
  },
  "dependencies": {
    "@solvaren/core": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
